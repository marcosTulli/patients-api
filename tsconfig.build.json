{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": ".",
    "paths": {
      "src/": ["src/*"],
      "@users/*": ["src/users/*"],
      "@auth/*": ["src/auth/*"]
    }
  },
  "exclude": ["node_modules", "dist", "test", "**/*spec.ts"],
  "include": ["src/**/*"]
}
