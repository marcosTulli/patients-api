{
  "info": {
    "name": "Create Patient Tests",
    "description": "Comprehensive test collection for patient creation",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "apiKey",
      "value": "API KEY",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Create Patient - Valid",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": {
          "raw": "{{baseUrl}}/patients/create",
          "host": ["{{baseUrl}}"],
          "path": ["patients", "create"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"Cacique\",\n  \"lastName\": \"Yatel\",\n  \"email\": \"cacique.yatel@example.com\",\n  \"phoneNumber\": \"123-456-7890\",\n  \"dob\": \"1980-05-20\"\n}"
        }
      },
      "response": []
    },
    {
